# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Environment and secrets
.env
.env.local
.env.*.local
*.key
*.pem
**/secrets/**

# Claude Code local overrides
.claude/settings.local.json
.claude/.local/

# Large data dumps kept out of version control
data/**/*.csv
data/**/*.xlsx
data/**/*.xls
data/**/*.json
data/**/*.zip
data/**/*.tsv
!data/README.md
!data/**/.gitkeep
# Committed canonical templates (not data dumps): copy-source import files
!data/templates/*.xlsx
# Generated report binaries (keep templates and markdown, not PDFs)
reports/monthly/*.pdf
reports/monthly/*.docx
!reports/monthly/.gitkeep

# Temporary
*.tmp
*.log
*.bak

# Python build artifacts
__pycache__/
*.pyc

# Generated presentation build output (keep source scripts, not rendered artifacts)
scripts/build/

# Credentials and secrets — never commit
*.json
!package.json
!package-lock.json
!tsconfig.json
# Batch gate run log. Carries no secrets: exit code, timestamp, which checks ran,
# and the Registry 1 row count. It MUST be tracked, because its whole purpose is to
# make "the gate passed" auditable after the fact. Caught 2026-08-19: the blanket
# *.json rule above was silently swallowing it, which would have left the record
# undiscoverable in exactly the way the log was built to prevent.
!**/_gate-run.json
# Shared workforce config (permissions allowlist, no secrets). The personal
# .claude/settings.local.json stays ignored via the "Claude Code local overrides" rule above.
!.claude/settings.json
.gcp/
credentials/
.env
.env.local
.credentials/
*-credentials.json
*-service-account*.json

# Workforce cost log — local only; not committed to GitHub
deliverables/tracking/cost-log.md
